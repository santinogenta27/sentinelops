# Copy to .env and fill in. All values have safe defaults.

# Public demo: DEMO_MODE=true switches off Stripe, IMAP/SMTP, LLM providers, Gemini embeddings and LangSmith
# (their keys are ignored), shows a "Demo mode" banner and rate-limits requests per client IP. Default: false.
DEMO_MODE=false
# DEMO_RATE_LIMIT_PER_MINUTE=300
# DEMO_WRITE_LIMIT_PER_MINUTE=20
# DEMO_MAX_BODY_BYTES=65536
# DEMO_CLIENT_IP_HEADERS=true-client-ip,cf-connecting-ip   # headers set by a trusted edge (Render/Cloudflare)
# DEMO_TRUSTED_PROXY_HOPS=1
# LLM provider: gemini | groq | mock   (mock = deterministic offline engine, used by CI)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Client-side rate limit (requests/minute) to stay inside the free tier
LLM_RPM=10
# Note (Nov 2026): gemini-2.5-flash is no longer offered to new API keys -> GEMINI_MODEL=gemini-3.8-flash;
# llama-3.3-70b-versatile was retired on Groq free/developer tiers -> GROQ_MODEL=openai/gpt-oss-120b.

# Observability: optional LangSmith tracing of every graph run (needs BOTH variables; otherwise off).
# Traces include ticket text and customer emails; LANGSMITH_HIDE_INPUTS/HIDE_OUTPUTS=true redact them.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinelops
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Embeddings: local (deterministic hashing, zero network) | gemini
EMBEDDING_PROVIDER=local

# Business rules
HITL_THRESHOLD_USD=200
JUDGE_PASS_THRESHOLD=0.85
MAX_TOOL_RETRIES=3
MAX_REDRAFTS=2

# Storage
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Email channel
# ---------------------------------------------------------------------------
SUPPORT_EMAIL_ADDRESS=support@sentinelops.demo
SUPERVISOR_EMAIL=billing-supervisor@sentinelops.demo   # a *.demo address = alerts are simulated only
# Inbound webhook (Mailgun / SendGrid / Postmark / generic JSON). If set, callers must send X-Webhook-Token.
INBOUND_WEBHOOK_SECRET=

# IMAP listener — reads mail (seen or unseen) from the last EMAIL_LOOKBACK_MINUTES, creates a ticket, marks it \Seen.
# Bounces, auto-replies, newsletters, no-reply senders and our own replies are always skipped.
# Gmail: enable 2FA, create an App Password (https://myaccount.google.com/apppasswords), use it below.
ENABLE_EMAIL_LISTENER=false
IMAP_HOST=imap.gmail.com            # Outlook / Microsoft 365: outlook.office365.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX                   # or a Gmail label, e.g. Disputes
EMAIL_SUBJECT_KEYWORDS=             # optional filter, e.g. dispute,refund,reembolso (empty = any subject)
EMAIL_POLL_INTERVAL_S=30
EMAIL_LOOKBACK_MINUTES=120

# SMTP replies — real delivery ONLY for mail that genuinely arrived (IMAP / provider webhook).
# Cockpit simulations are never delivered. Defaults to the IMAP credentials.
ENABLE_EMAIL_SENDER=false
SMTP_HOST=smtp.gmail.com            # Outlook / Microsoft 365: smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Auto-Pilot (zero-touch). Approves policy-compliant payouts (no injection, sender owns the
# account, risk not HIGH) up to the ceiling; everything else still waits for a human.
# The cockpit toggle persists the live value in the database; this is only the first-boot default.
# ---------------------------------------------------------------------------
AUTOPILOT_DEFAULT=true
AUTOPILOT_MAX_USD=200
# Operator access: "name:token,name2:token2". When set, HITL decisions, ticket intake and settings need a
# token, and the audit trail records the token owner as reviewer. Set it on any shared or public deployment.
# REVIEWER_TOKENS=

# ---------------------------------------------------------------------------
# Stripe live dashboard + mirror. Use a TEST key (sk_test_...). Each ledger refund is mirrored
# into Stripe test mode. Live keys (sk_live_) are read-only: no charge/refund is ever created.
# ---------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_MIRROR_REFUNDS=true

# Mailbox: can also be connected from the cockpit ("⚙️ Conectar Casilla de Correo") without editing this file.
