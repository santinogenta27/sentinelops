# Copy to .env and fill in. All values have safe defaults.
# LLM provider: gemini | groq | mock   (mock = deterministic offline engine, used by CI)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Client-side rate limit (requests/minute) to stay inside the free tier
LLM_RPM=10

# Embeddings: local (deterministic hashing, zero network) | gemini
EMBEDDING_PROVIDER=local

# Business rules
HITL_THRESHOLD_USD=200
JUDGE_PASS_THRESHOLD=0.85
MAX_TOOL_RETRIES=3
MAX_REDRAFTS=2

# Storage
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Email channel
# ---------------------------------------------------------------------------
SUPPORT_EMAIL_ADDRESS=support@sentinelops.demo
SUPERVISOR_EMAIL=billing-supervisor@sentinelops.demo   # a *.demo address = alerts are simulated only
# Inbound webhook (Mailgun / SendGrid / Postmark / generic JSON). If set, callers must send X-Webhook-Token.
INBOUND_WEBHOOK_SECRET=

# IMAP listener — reads UNSEEN mail whose subject matches a keyword, creates a ticket, marks it \Seen.
# Gmail: enable 2FA, create an App Password (https://myaccount.google.com/apppasswords), use it below.
ENABLE_EMAIL_LISTENER=false
IMAP_HOST=imap.gmail.com            # Outlook / Microsoft 365: outlook.office365.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX                   # or a Gmail label, e.g. Disputes
EMAIL_SUBJECT_KEYWORDS=dispute,refund,charge,charged,billing,invoice,fraud,disputa,reembolso,cobro
EMAIL_POLL_INTERVAL_S=30

# SMTP replies — real delivery ONLY for mail that genuinely arrived (IMAP / provider webhook).
# Cockpit simulations are never delivered. Defaults to the IMAP credentials.
ENABLE_EMAIL_SENDER=false
SMTP_HOST=smtp.gmail.com            # Outlook / Microsoft 365: smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
